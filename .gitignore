# CreditSense – .gitignore
# Keep model files, exclude everything else that shouldn't be in the repo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Secrets / local config
.env
.env.*
*.local

# Logs
*.log
